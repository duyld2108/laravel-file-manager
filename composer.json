{
    "name": "duyld2108/laravel-file-manager",
    "description": "Standalone Advanced File Manager for Laravel with Intervention Image v4.1+ support, auto image resizing, WebP/AVIF conversion, disk thumbnail cache and enterprise security",
    "type": "library",
    "keywords": [
        "laravel",
        "file",
        "manager",
        "filemanager",
        "media",
        "intervention",
        "image",
        "webp",
        "avif",
        "resize",
        "ckeditor",
        "tinymce"
    ],
    "homepage": "https://github.com/duyld2108/laravel-file-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Le Duc Duy",
            "email": "duyld@tnus.edu.vn",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/duyld2108/laravel-file-manager/issues",
        "source": "https://github.com/duyld2108/laravel-file-manager"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "ext-zip": "*",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "league/flysystem": "^3.0",
        "intervention/image-laravel": "^1.2.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Duyld2108\\LaravelFileManager\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Duyld2108\\LaravelFileManager\\FileManagerServiceProvider"
            ]
        }
    }
}
